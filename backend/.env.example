# VibeTune Backend Environment Variables
# Copy this to .env.local and fill in your actual values

# ─── Node Environment ───────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── First-party Authentication ─────────────────────────
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=vibetune-api
JWT_AUDIENCE=vibetune-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=re_your_resend_api_key
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Supabase PostgreSQL Database ───────────────────────
DB_HOST=your-project.supabase.co
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=postgres
DB_PORT=5432

# ─── External APIs ──────────────────────────────────────
# CLIP Vision Model for vibe extraction (Hugging Face Space)
CLIP_URL=https://your-username-vibetune-clip.hf.space

# iTunes Search API (country code for results)
ITUNES_API_COUNTRY=US

# Weather service provider
# - weatherapi: use WeatherAPI (requires WEATHERAPI_KEY)
# - open-meteo: use legacy Open-Meteo provider
WEATHER_PROVIDER=weatherapi

# WeatherAPI (new provider)
WEATHERAPI_KEY=your_weatherapi_key
# Optional: override default endpoint
# WEATHERAPI_CURRENT_URL=https://api.weatherapi.com/v1/current.json

# Legacy Open-Meteo endpoint (kept for backward compatibility / fallback)
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ─── Redis Caching (Upstash) ────────────────────────────
# Get these from https://upstash.com/docs/redis/features/rest-api
UPSTASH_REDIS_REST_URL=https://your-region-redis-xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AZxxxxxxxxxxxxxxxxxxxxx

# Example: 
# UPSTASH_REDIS_REST_URL=https://us1-steady-mouse-12345.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AZxxx...

# ─── CORS Configuration ─────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ─── Admin Operations ───────────────────────────────────
# Used to authenticate admin endpoints (/admin/cache/invalidate)
# Should be a strong, random string (32+ characters)
ADMIN_SECRET=your-super-secret-admin-token-here-min-32-chars

# Example:
# ADMIN_SECRET=sk_admin_4df8b3c9e2f1a0d7c5b9e1f3a5d7c9b1
